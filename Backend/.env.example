# ============ LeafAI 后端环境变量示例 ============
# 复制本文件为 .env 并填入真实值：
#   cp .env.example .env          (Linux/macOS)
#   copy .env.example .env        (Windows)
# 切勿把含真实密钥的 .env 提交到版本库。

# ---------- 项目 ----------
PROJECT_NAME=LeafAI
DEBUG=true

# ---------- 数据库（PostgreSQL） ----------
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/leafai
DATABASE_SYNC_URL=postgresql://postgres:change_me@localhost:5432/leafai

# ---------- Redis（可选，用于任务/限流） ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- API ----------
API_V1_PREFIX=/api/v1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ---------- 图片服务（OpenAI 兼容参数，任意同类服务均可） ----------
# IMAGE_API_KEY / IMAGE_BASE_URL 指向任一兼容 /images/generations 的图片服务即可：
IMAGE_API_KEY=
IMAGE_BASE_URL=

# ---------- 对话服务 ----------
DEEPSEEK_API_KEY=

# ---------- JWT 签名密钥（生产环境务必覆盖为随机长字符串） ----------
# 可用以下命令生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=